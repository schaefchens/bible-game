<?php
/**
 * Wake-controller configuration.
 *
 * Copy this file to config.php (same directory) and fill it in. config.php is
 * gitignored and MUST NEVER be committed — it holds a Hetzner Cloud API token,
 * which is full control of the cloud project.
 *
 * The previous version of this script carried its token as a literal default in
 * the source, and that file is committed to a public repository. Do not
 * reintroduce a fallback here: fetch-game-server.php refuses to run rather than
 * guess, on purpose.
 *
 * Every value can also come from the environment (HCLOUD_TOKEN,
 * GAME_SERVER_ADMIN_KEY); the environment wins over this file.
 */

return [
    // --- secrets -------------------------------------------------------------

    // Hetzner Cloud API token, project-scoped. Console → Security → API tokens.
    'hcloud_token' => 'REPLACE_WITH_A_FRESH_HETZNER_CLOUD_TOKEN',

    // Guards the GET actions (status, destroy-if-idle, destroy-now), which are
    // reachable by anyone who can guess the URL. Generate with:
    //   openssl rand -hex 32
    // The old default was the literal string "s3cr3t". It was never changed.
    'admin_key' => 'REPLACE_WITH_openssl_rand_hex_32',

    // --- where the game lives ------------------------------------------------

    // Browser origins allowed to call this endpoint. The web build's origin,
    // plus the two a Capacitor webview sends (Android reports https://localhost,
    // iOS capacitor://localhost) if the native apps are to reach co-op.
    'allowed_origins' => [
        'https://walkinthespirit.games.schaefchens.de',
        // 'https://localhost',
        // 'capacitor://localhost',
    ],

    // Handed back to the client once the server is up. The websocket URL is the
    // one that matters — serverResolve.ts connects to exactly this string, so
    // it has to match the certificate on the VPS or the wss:// handshake fails.
    // The host needs an A record on the reserved primary IPv4 (167.233.229.238)
    // and an AAAA on the reserved /64.
    'game_url' => 'https://walkinthespirit.games.schaefchens.de/',
    'websocket_url' => 'wss://walkinthespirit-coop.games.schaefchens.de/ws',

    // --- the Hetzner resources this script creates ---------------------------
    //
    // Carried over from the old setup (komm-folge-mir-nach.de). VERIFY EACH ONE
    // still exists in the project before trusting it — the snapshot in
    // particular is what the server boots from, and an id that no longer
    // resolves fails at creation time, not at deploy time.

    'server_name' => 'spirit-game-server',
    'server_type' => 'cpx12',
    'location'    => 'fsn1',
    'ssh_key'     => 'abraham@der-weg-des-herrn.de',
    'firewall'    => 'firewall-spirit-game-server',

    // Snapshot the server boots from. Bump this after every provision.sh run
    // that you re-snapshot, or recreations silently start from the old state.
    //
    // 430388620  spirit-game-server-20260910T154812Z  ← current
    //            Everything provision.sh installs: the walkinthespirit-coop
    //            vhost and its certificate, the boot/deploy scripts from
    //            deploy/server/, and the certbot no-random-sleep drop-in.
    //            Boots in ~21s; wake-to-ready measured at 42s.
    // 430386111  spirit-game-server-20260910T153229Z
    //            same, without the certbot drop-in.
    // 406645289  spirit-game-server-initial
    //            the original. Boots serving game.komm-folge-mir-nach.de with
    //            a certificate for a domain that no longer resolves, so its
    //            boot-time renewal attempt stalls for minutes. Only useful as
    //            a floor to re-run provision.sh against.
    'image'       => 430388620,

    // Reserved so the DNS record keeps pointing at the same address across
    // recreations. Both survived the move: the IPv4 is 167.233.229.238 and the
    // IPv6 /64 is 2a01:4f8:c015:b470::/64.
    'primary_ipv4_name' => 'primary_ip-139525751-spirit-game-server',

    // Empty = IPv4 only. Set, and the server is dual-stack — which it must be
    // whenever an AAAA record exists for the co-op host, because the two have
    // to agree. An AAAA with no listener behind it costs browsers a Happy
    // Eyeballs fallback on every connect, and can fail a Let's Encrypt
    // renewal outright: the CA resolves AAAA first and prefers it.
    'primary_ipv6_name' => 'primary_ip-139525752-spirit-game-server',

    // --- idle shutdown -------------------------------------------------------

    // The server is destroyed once no heartbeat has arrived for this long. The
    // client heartbeats every 5 min while co-op is open (net/client.ts).
    'idle_destroy_after_seconds' => 3600,
];
