# Copy to sftp.env and fill in. sftp.env is gitignored — never commit it.
#
# Credentials for the SFTP account that serves
# https://walkinthespirit.games.schaefchens.de
#
# The account is jailed to the subdomain's document root, so remote "/" IS the
# web root. There is no shell on the far side — everything the deploy does has
# to be expressible as an sftp batch command.

SFTP_SERVER=user@www99.your-server.de
SFTP_PASSWD=the-password
