# Vite writes this beside vite.config.ts while loading the TS config and removes it after. It is
# untracked for the moments it exists, which is long enough for the config's OWN `git status` check
# to see it and stamp every single build "-dirty" from a spotless tree — the build stamp in Settings
# and the co-op buildHash both lied because of it. A crashed build also leaves one behind.
vite.config.ts.timestamp-*.mjs

# Wake-controller secrets (Hetzner token, admin key) — never commit;
# copy deploy/api/config.php.example to deploy/api/config.php
deploy/api/config.php

# Runtime state the wake controller writes next to itself on the server.
deploy/api/spirit-game-last-activity.txt
deploy/api/spirit-game-server.lock
deploy/api/admin-audit.log
deploy/api/admin-audit.log.1
