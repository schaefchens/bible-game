# Production web build. Committed on purpose: everything here is baked into the
# bundle and served to every visitor, so it is public by construction. Secrets
# belong in deploy/api/config.php, which is gitignored and never shipped to the
# client.

# The co-op wake endpoint. Same origin as the game, so no CORS preflight and
# nothing to configure per environment. Unset, the client reports
# ui.coop.errNoServer and co-op is off — which is what it was until the server
# came back. See deploy/api/README.md.
VITE_WAKE_ENDPOINT=https://walkinthespirit.games.schaefchens.de/api/fetch-game-server.php

# VITE_WS_URL is deliberately NOT set here. The web client probes the
# same-origin /ws first and otherwise connects to whatever websocketUrl the
# wake endpoint hands back, so the host lives in one place (the wake config)
# rather than two. Capacitor builds are the exception and must set it — they
# have no same-origin server to probe.
