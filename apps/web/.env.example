# Build-time configuration for the web app. Copy to .env.local for local
# overrides; CI and scripts/deploy.sh pass these on the command line instead.
#
# Everything here is BAKED INTO THE BUNDLE at build time — it is public. Never
# put a secret in this file or in .env.local.

# Deployment base. Defaults to "/" (walkinthespirit.games.schaefchens.de serves
# the app at the domain root). Capacitor builds need "./" so index.html can
# resolve its assets off the device filesystem — `npm run build:app` sets it.
# VITE_BASE=/

# Skip the service worker entirely. Set for Capacitor builds (the native shell
# already serves the bundle locally). `npm run build:app` sets it.
# VITE_DISABLE_PWA=1

# Co-op WebSocket server, absolute. Unset on the web: wsUrl() derives
# wss://<host>/ws from the page's own origin, and `npm run dev` proxies /ws to
# the local Node server on :8787. A Capacitor build has no same-origin server
# and MUST set this to reach co-op at all.
# VITE_WS_URL=wss://coop.example.com/ws

# Endpoint that wakes the on-demand co-op server. The controller lives in this
# repo (deploy/api/fetch-game-server.php) and the deploy ships it to /api once
# deploy/api/config.php exists. Unset means "no co-op server": the client
# reports `ui.coop.errNoServer` at once rather than waiting out a timeout.
# The production web build already sets this in .env.production — you only need
# it here for a build that is not that one (a Capacitor app, a staging host).
# See deploy/api/README.md.
# VITE_WAKE_ENDPOINT=https://walkinthespirit.games.schaefchens.de/api/fetch-game-server.php

# Short commit SHA shown in Settings. The build derives it from git when unset;
# CI passes it explicitly.
# VITE_GIT_SHA=
